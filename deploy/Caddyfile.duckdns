# Caddy for the DuckDNS setup:  gateway = sandbox-uipe.duckdns.org   previews = <id>.sandbox-uipe.duckdns.org
# DNS: DuckDNS answers *.sandbox-uipe.duckdns.org with the same IP as sandbox-uipe.duckdns.org (no extra record needed).
# The wildcard certificate needs the DNS challenge, so Caddy must be built with the DuckDNS module:
#     sudo caddy add-package github.com/caddy-dns/duckdns && sudo systemctl restart caddy
# and the DuckDNS token goes in /etc/caddy/caddy.env (DUCKDNS_API_TOKEN=...) loaded by the caddy service (EnvironmentFile=).

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

sandbox-uipe.duckdns.org {
	import secure_headers
	@ws path /ws /healthz
	handle @ws {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		respond 404
	}
}

*.sandbox-uipe.duckdns.org {
	import secure_headers
	tls {
		dns duckdns {env.DUCKDNS_API_TOKEN}
	}
	request_body {
		max_size 100MB
	}
	reverse_proxy 127.0.0.1:8787
}
